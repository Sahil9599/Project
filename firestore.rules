rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'email', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['userId', 'email', 'displayName', 'totalConversions', 'storageUsedBytes', 'createdAt', 'updatedAt']) &&
             data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('totalConversions' in data) || data.totalConversions is number) &&
             (!('storageUsedBytes' in data) || data.storageUsedBytes is number) &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidConversionRecord(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'conversionType', 'status', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'userId', 'conversionType', 'originalFilesCount', 'originalFileNames', 'totalOriginalSizeBytes', 'totalResultSizeBytes', 'compressionQuality', 'compressionRatio', 'status', 'outputSummary', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId == userId && data.userId == request.auth.uid &&
             data.conversionType is string && data.conversionType.size() <= 64 &&
             data.status is string && data.status.size() <= 32 &&
             (!('originalFilesCount' in data) || data.originalFilesCount is number) &&
             (!('originalFileNames' in data) || (data.originalFileNames is list && data.originalFileNames.size() <= 100)) &&
             (!('totalOriginalSizeBytes' in data) || data.totalOriginalSizeBytes is number) &&
             (!('totalResultSizeBytes' in data) || data.totalResultSizeBytes is number) &&
             (!('compressionQuality' in data) || (data.compressionQuality is string && data.compressionQuality.size() <= 64)) &&
             (!('compressionRatio' in data) || data.compressionRatio is number) &&
             (!('outputSummary' in data) || (data.outputSummary is string && data.outputSummary.size() <= 256)) &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidStoredFile(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'fileName', 'fileType', 'sizeBytes', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'userId', 'conversionRecordId', 'fileName', 'fileType', 'sizeBytes', 'fileData', 'thumbnailUrl', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId == userId && data.userId == request.auth.uid &&
             data.fileName is string && data.fileName.size() <= 256 &&
             data.fileType is string && data.fileType.size() <= 64 &&
             data.sizeBytes is number &&
             (!('conversionRecordId' in data) || (data.conversionRecordId is string && data.conversionRecordId.size() <= 128)) &&
             (!('fileData' in data) || (data.fileData is string && data.fileData.size() <= 1048576)) &&
             (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 262144)) &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data);
      allow delete: if isOwner(userId) && isValidId(userId);

      match /conversions/{conversionId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(conversionId) && isValidConversionRecord(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(conversionId) && isValidConversionRecord(request.resource.data, userId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(conversionId);
      }

      match /files/{fileId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(fileId) && isValidStoredFile(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(fileId) && isValidStoredFile(request.resource.data, userId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(fileId);
      }
    }
  }
}
